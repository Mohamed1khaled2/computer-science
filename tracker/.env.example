# All optional. Missing ones just turn that feature off (see Settings → حالة السيرفر).

# Protects every API route; type the same value in the app's Settings on each device.
SYNC_KEY=change-me-to-a-long-random-string

# Upstash Redis (Vercel Storage adds KV_REST_API_URL / KV_REST_API_TOKEN instead — both work)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Upstash QStash — schedules the reminder at the time you promised
QSTASH_TOKEN=
QSTASH_URL=

# Google Gemini (https://aistudio.google.com/apikey): the academic advisor chat + daily message,
# and the examiner when ANTHROPIC_API_KEY is not set
GEMINI_API_KEY=
# Optional, defaults to gemini-flash-latest
GEMINI_MODEL=

# Claude examiner that grades your answers (takes priority over Gemini for grading)
ANTHROPIC_API_KEY=

# Optional: production URL used as the reminder callback
APP_URL=
